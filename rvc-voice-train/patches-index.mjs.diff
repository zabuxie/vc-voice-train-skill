+// RVC 模型本身只换音色不挑语言，把驱动源换成对应语言的 Edge 语音即可。
+const LANG_VOICE_RE = [
+  ['ja', /[\u3040-\u30ff\u31f0-\u31ff]/],   // 平假名/片假名
+  ['ko', /[\uac00-\ud7af\u1100-\u11ff]/],   // 谚文
